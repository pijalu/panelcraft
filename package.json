{
  "name": "panelcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-only web architecture diagramming tool (IcePanel-inspired). Single-source .pcd format, WYSIWYG canvas + code view.",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "corpus:accept": "node scripts/corpus-accept.mjs",
    "corpus:check": "vitest run web/src/engine/format/corpus.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
