pcd 1.0

system user "Shopper"
system shop "Webshop"
system erp "ERP"

user -requests-> shop as L1 {
  style {
    sparks 3
    speed 2
  }
}
shop -> erp as L2
user -> erp as L3 {
  style {
    sparks 2
    speed 0.5
  }
}

flow "Burst" {
  process shop
  user -> shop : "browse"
  shop -> erp : "sync"
}
