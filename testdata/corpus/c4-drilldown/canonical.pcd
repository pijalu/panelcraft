pcd 1.0
title "Shop — system context"
level context

person shopper "Shopper"
system shop "Webshop" {
  description "Storefront"
  technology "React"
  drilldown "containers/shop.pcd" view containers
}
system_ext psp "Payment provider"

shopper -> shop : "browses"
shop -requests-> psp : "charges"

view "Context" {
  layout auto LR
}
