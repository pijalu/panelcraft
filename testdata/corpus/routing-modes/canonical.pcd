pcd 1.0
# SPDX-License-Identifier: GPL-3.0-only
title "Routing modes"

system client "Client"
system api "API"
system worker "Worker"

client -requests-> api as direct {
  style {
    route straight
  }
}
api -publishes-> worker : "jobs" as curve {
  style {
    route curved
    width 2
  }
  waypoint (300, 180)
}
client -> worker : "fallback" as ortho
